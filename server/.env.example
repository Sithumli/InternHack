# InternHack - server environment template
#
# Quick start:
#   cp .env.example .env
#   Fill in at least JWT_SECRET plus any OAuth/API keys you need.

# ── Database (required) ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internhack

# ── Server (minimum boot: DATABASE_URL + JWT_SECRET in server/src/index.ts) ──
JWT_SECRET=
VERIFICATION_SECRET=

DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PRODUCT_ID_MONTHLY=
DODO_PRODUCT_ID_YEARLY=
DODO_PRODUCT_ID_EXPERT_SESSION=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GEMINI_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
VITE_API_URL=
ALLOWED_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
# ── Google Calendar (auto-generates a Meet link when a peer mock interview time is accepted) ──
# Uses a dedicated Google account's OAuth2 refresh token, not end-user login.
#   1. Create OAuth2 credentials (type: Desktop app) in Google Cloud Console for a project
#      with the Calendar API enabled.
#   2. Run the consent flow once for the account that should own these events, requesting the
#      "https://www.googleapis.com/auth/calendar.events" scope, and capture the refresh token
#      Google returns.
#   3. Paste that client id/secret/refresh token below. Leave any of these blank to disable the
#      integration — scheduling then falls back to the manually-entered meeting link.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Calendar to create events on for the account above. "primary" uses that account's main calendar.
GOOGLE_CALENDAR_ID=primary
RESEND_API_KEY=
EMAIL_FROM=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CODESTRAL_API_KEY=
JUDGE0_RAPIDAPI_KEY_1=
JUDGE0_RAPIDAPI_KEY_2=
JUDGE0_RAPIDAPI_KEY_3=
JUDGE0_RAPIDAPI_KEY_4=
INBOUND_FORWARD_TO=
RESEND_WEBHOOK_SECRET=
CLAUDE_API=
EXA_API_KEY=
EXTERNAL_JOB_API_KEY=
# LeetCode import server flag — false to disable (default: enabled)
LEETCODE_IMPORT_ENABLED=true

# ── Client (Vite - exposed to the browser — prefix required) ────────────
VITE_GOOGLE_CLIENT_ID=
VITE_DODO_MODE=test_mode
# LeetCode import client flag — set to false to disable (default: enabled)
VITE_LEETCODE_IMPORT_ENABLED=true
LOG_LEVEL=info
GITHUB_CLIENT_ID=your_copied_client_id
GITHUB_CLIENT_SECRET=your_copied_client_secret
# Must be a 64-character hex key (32 bytes) for AES-256-GCM encryption
APP_PASSWORD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef